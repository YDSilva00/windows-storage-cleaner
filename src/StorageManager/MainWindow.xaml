<Window x:Class="StorageManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageManager.ViewModels"
        xmlns:m="clr-namespace:StorageManager.Models"
        Title="Storage Manager - find what is filling your drive"
        Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- ─────────── Cleanup item card (used by Junk Cleaner and Hidden Space tabs) ─────────── -->
        <DataTemplate x:Key="CleanupItemTemplate" DataType="{x:Type vm:CleanupItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,2,10,0" MinWidth="0"
                              IsChecked="{Binding IsSelected}"
                              Visibility="{Binding CanClean, Converter={StaticResource Visible}}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Background="{Binding Safety, Converter={StaticResource SafetyBrush}}">
                            <TextBlock Text="{Binding SafetyText}" Foreground="White" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#605E5C"
                                Visibility="{Binding NeedsAdminWarning, Converter={StaticResource Visible}}">
                            <TextBlock Text="Admin needed" Foreground="White" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold" MinWidth="90"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <ToggleButton AutomationProperties.Name="Details" IsChecked="{Binding IsExpanded}" Margin="10,0,0,0" Padding="8,4" ToolTip="Details and how to fix">
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" />
                        </ToggleButton>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Subtle}" Margin="0,4,12,0" />

                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Status}" Margin="0,6,0,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"
                               Visibility="{Binding Status, Converter={StaticResource Visible}}" />

                    <!-- Expanded details -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                        <TextBlock Text="Found on this PC" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Visibility="{Binding Locations.Count, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Locations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                        <Button Grid.Column="2" Content="Open" Padding="8,2" Margin="6,0,0,0"
                                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="How to fix" FontWeight="SemiBold" Margin="0,10,0,4"
                                   Visibility="{Binding Advice, Converter={StaticResource Visible}}" />
                        <TextBox Text="{Binding Advice, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Visibility="{Binding Advice, Converter={StaticResource Visible}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding FixLabel}" Command="{Binding FixCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    Padding="12,5" Margin="0,0,8,0" Visibility="{Binding HasFix, Converter={StaticResource Visible}}" />
                            <Button Content="Open folder" Command="{Binding OpenCommand}" Padding="12,5" Margin="0,0,8,0" />
                            <Button Content="Copy details" Command="{Binding CopyAdviceCommand}" Padding="12,5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <GroupStyle x:Key="CleanupGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- Shared context menu for tree and lists. CommandParameter = the selected item of the control. -->
        <ContextMenu x:Key="NodeMenu" x:Shared="False">
            <MenuItem Header="Open in Explorer"
                      Command="{Binding OpenInExplorerCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Copy path"
                      Command="{Binding CopyPathCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Move to Recycle Bin"
                      Command="{Binding RecycleCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Delete permanently…"
                      Command="{Binding DeletePermanentlyCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <DataTemplate x:Key="FileRowName" DataType="{x:Type m:FsNode}">
            <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Admin banner -->
        <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="16,8"
                Visibility="{Binding IsAdmin, Converter={StaticResource Hidden}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" AutomationProperties.Name="Restart as administrator" Command="{Binding RestartAsAdminCommand}" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Restart as administrator" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding AdminText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Padding="0" Margin="8,6,8,8">

            <!-- ═══════════════════════════ OVERVIEW ═══════════════════════════ -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Your drives" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12"
                                   Text="Explorer and Settings hide a lot: hidden system files, restore points, WSL/Docker disks and app caches. Analyze a drive to see every folder, including hidden ones, sorted by size." />

                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                    <Border Style="{StaticResource Card}" Width="360" Margin="0,0,12,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ProgressBar Value="{Binding PercentUsed, Mode=OneWay}" Maximum="100" Height="10" Margin="0,12,0,6"
                                                         Foreground="{Binding PercentUsed, Converter={StaticResource UsageBrush}}" />
                                            <TextBlock Style="{StaticResource Subtle}">
                                                <Run Text="{Binding Free, Mode=OneWay, Converter={StaticResource Bytes}}" FontWeight="SemiBold" />
                                                <Run Text="free of" />
                                                <Run Text="{Binding Total, Mode=OneWay, Converter={StaticResource Bytes}}" />
                                                <Run Text="  •  " />
                                                <Run Text="{Binding PercentUsed, Mode=OneWay, Converter={StaticResource Percent}}" />
                                                <Run Text="used" />
                                            </TextBlock>
                                            <Button Content="Analyze this drive" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="14,5"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    Command="{Binding DataContext.AnalyzeDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Refresh drives" Command="{Binding RefreshDrivesCommand}" HorizontalAlignment="Left" Padding="12,4" />

                        <TextBlock Text="Why is C: full when I can't see the files?" Style="{StaticResource PageTitle}" FontSize="20" Margin="0,24,0,8" />
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="1. Hidden system files" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Subtle}" Text="hiberfil.sys and pagefile.sys sit hidden at the root of C: and can take 10-40 GB together. Restore points in 'System Volume Information' are invisible even to administrators." />
                                    <Button Content="Check hidden space" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,4" Command="{Binding GoToTabCommand}" CommandParameter="3" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="2. Virtual disks that never shrink" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Subtle}" Text="WSL (ext4.vhdx), Docker Desktop and VM disks grow automatically and keep their size after you delete files inside them. Forgotten VM disks of 50-200 GB are common." />
                                    <Button Content="Find virtual disks" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,4" Command="{Binding GoToTabCommand}" CommandParameter="3" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="3. Caches in AppData" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Subtle}" Text="AppData is hidden. Browser, Teams, Spotify, NuGet, npm, Gradle and pip caches, plus GPU shader caches and crash dumps, can quietly reach tens of GB." />
                                    <Button Content="Open Junk Cleaner" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,4" Command="{Binding GoToTabCommand}" CommandParameter="2" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="4. Windows update leftovers" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Subtle}" Text="Windows.old, the WinSxS component store, old driver packages, the Update download cache and Delivery Optimization files. Clean them only with Windows' own tools." />
                                    <Button Content="Open Storage settings" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,4" Command="{Binding OpenStorageSettingsCommand}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════ DISK ANALYZER ═══════════════════════════ -->
            <TabItem Header="Disk Analyzer" DataContext="{Binding Analyzer}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Padding="14,5" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" AutomationProperties.Name="Scan" Command="{Binding ScanCommand}" Padding="14,5" Margin="8,0,0,0"
                                Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Padding="14,5" Margin="8,0,0,0" />
                        <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,8">
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6"
                                     Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>

                    <!-- Space accounting summary -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10"
                            Visibility="{Binding IsDriveScan, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <UniformGrid Columns="5">
                                <StackPanel>
                                    <TextBlock Text="Used on drive" Style="{StaticResource Subtle}" />
                                    <TextBlock Text="{Binding DriveUsed, Converter={StaticResource Bytes}}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Found by scan" Style="{StaticResource Subtle}" />
                                    <TextBlock Text="{Binding ScannedTotal, Converter={StaticResource Bytes}}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel ToolTip="hiberfil.sys + pagefile.sys + swapfile.sys (already included in 'Found by scan')">
                                    <TextBlock Text="…of which hidden system files" Style="{StaticResource Subtle}" />
                                    <TextBlock Text="{Binding HiddenSystemFiles, Converter={StaticResource Bytes}}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel ToolTip="System Restore points stored in 'System Volume Information'">
                                    <TextBlock Text="Restore points" Style="{StaticResource Subtle}" />
                                    <TextBlock Text="{Binding ShadowCopies, Converter={StaticResource Bytes}, ConverterParameter='needs admin'}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel ToolTip="Used space that is not in any folder the scan could read">
                                    <TextBlock Text="Not accounted for" Style="{StaticResource Subtle}" />
                                    <TextBlock Text="{Binding Unexplained, Converter={StaticResource Bytes}}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding SummaryHint}" Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                       Visibility="{Binding SummaryHint, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="300" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="2*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <!-- Folder tree -->
                        <Border Style="{StaticResource Card}" Padding="4">
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <TextBlock Text="{Binding SelectedItem.FullPath, ElementName=Tree}" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" TextWrapping="NoWrap" />
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Margin="8,4" Style="{StaticResource Subtle}"
                                           Text="Folders sorted by size. Right-click an item to open, copy or delete it." />
                                <TreeView x:Name="Tree" ItemsSource="{Binding RootItems}" ContextMenu="{StaticResource NodeMenu}"
                                          BorderThickness="0"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                                          MouseDoubleClick="Tree_MouseDoubleClick">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type m:FsNode}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                                <Grid Width="64" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <ProgressBar Value="{Binding PercentOfParent, Mode=OneWay}" Maximum="100" MinHeight="0" Height="8" />
                                                </Grid>
                                                <TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}" Width="78" TextAlignment="Right"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PercentOfParent, Converter={StaticResource Percent}}" Width="58" TextAlignment="Right"
                                                           Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- Side lists -->
                        <TabControl Grid.Column="2">
                            <TabItem Header="Largest files">
                                <ListView ItemsSource="{Binding LargestFiles}" ContextMenu="{StaticResource NodeMenu}" MouseDoubleClick="List_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size, Converter={StaticResource Bytes}}" />
                                            <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Modified" Width="90" DisplayMemberBinding="{Binding LastWriteUtc, Converter={StaticResource LocalDate}}" />
                                            <GridViewColumn Header="Location" Width="400" CellTemplate="{StaticResource FileRowName}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                            <TabItem Header="Largest folders">
                                <ListView ItemsSource="{Binding TopFolders}" ContextMenu="{StaticResource NodeMenu}" MouseDoubleClick="List_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size, Converter={StaticResource Bytes}}" />
                                            <GridViewColumn Header="Files" Width="80" DisplayMemberBinding="{Binding FileCount, StringFormat=N0}" />
                                            <GridViewColumn Header="Folder" Width="480" CellTemplate="{StaticResource FileRowName}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                            <TabItem Header="Old big files" ToolTip="Files over 50 MB that haven't changed in more than a year">
                                <ListView ItemsSource="{Binding OldLargeFiles}" ContextMenu="{StaticResource NodeMenu}" MouseDoubleClick="List_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size, Converter={StaticResource Bytes}}" />
                                            <GridViewColumn Header="Modified" Width="90" DisplayMemberBinding="{Binding LastWriteUtc, Converter={StaticResource LocalDate}}" />
                                            <GridViewColumn Header="File" Width="480" CellTemplate="{StaticResource FileRowName}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                            <TabItem Header="File types">
                                <ListView ItemsSource="{Binding Extensions}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Extension}" />
                                            <GridViewColumn Header="Total size" Width="110" DisplayMemberBinding="{Binding TotalSize, Converter={StaticResource Bytes}}" />
                                            <GridViewColumn Header="Files" Width="100" DisplayMemberBinding="{Binding FileCount, StringFormat=N0}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════ JUNK CLEANER ═══════════════════════════ -->
            <TabItem Header="Junk Cleaner" DataContext="{Binding Junk}">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Junk &amp; cache cleaner" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,10"
                                   Text="Only caches and temporary files that apps rebuild automatically. Your documents, passwords, browser history and settings are never touched. Locked files are skipped." />
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Select all" Command="{Binding SelectAllCommand}" CommandParameter="True" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="Select none" Command="{Binding SelectAllCommand}" CommandParameter="False" Padding="10,5" Margin="0,0,12,0" />
                                <Button Content="Scan" Command="{Binding ScanCommand}" Padding="16,5" Margin="0,0,6,0" />
                                <Button AutomationProperties.Name="Clean selected" Command="{Binding CleanSelectedCommand}" Padding="16,5" Margin="0,0,6,0" Style="{DynamicResource AccentButtonStyle}">
                                    <TextBlock>
                                        <Run Text="Clean selected (" /><Run Text="{Binding SelectedTotal, Mode=OneWay, Converter={StaticResource Bytes}}" /><Run Text=")" />
                                    </TextBlock>
                                </Button>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,5" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource CleanupItemTemplate}" Margin="0,0,8,0">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="CleanupGroupStyle" />
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ═══════════════════════════ HIDDEN SPACE ═══════════════════════════ -->
            <TabItem Header="Hidden Space" DataContext="{Binding Hidden}">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Hidden space hogs" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,10"
                                   Text="These are the places that most often explain a full C: drive that you can't see in Explorer or Settings. Many are system-managed, so the app shows the size and the safe, official way to shrink each one instead of deleting files blindly." />
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Scan" Command="{Binding ScanCommand}" Padding="16,5" Margin="0,0,6,0" Style="{DynamicResource AccentButtonStyle}" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,5" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource CleanupItemTemplate}" Margin="0,0,8,0">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="CleanupGroupStyle" />
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
